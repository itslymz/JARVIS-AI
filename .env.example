# ============================================
# JARVIS-AI Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# FastAPI Configuration
# ============================================
FASTAPI_ENV=development
DEBUG=True
API_TITLE=JARVIS-AI
API_VERSION=0.1.0
API_DESCRIPTION=Autonomous AI Operating System

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://jarvis_user:jarvis_password@postgres:5432/jarvis_db
DATABASE_ECHO=True

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_EXPIRE=3600

# ============================================
# Qdrant Configuration
# ============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=jarvis_memories
QDRANT_VECTOR_SIZE=1536

# ============================================
# JWT Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ============================================
# AI Models Configuration
# ============================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229
ANTHROPIC_MAX_TOKENS=2000

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# Default Model Selection
DEFAULT_MODEL_PROVIDER=ollama
DEFAULT_MODEL=mistral

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=JARVIS-AI

# ============================================
# Voice Configuration
# ============================================
VOICE_WAKE_WORD=jarvis
VOICE_RECOGNITION_LANGUAGE=en-US
VOICE_TTS_PROVIDER=pyttsx3
VOICE_ENABLE_CONTINUOUS_LISTENING=False

# ============================================
# RabbitMQ Configuration
# ============================================
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_QUEUE_NAME=jarvis_tasks

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/jarvis.log

# ============================================
# Security Configuration
# ============================================
ALLOWED_HOSTS=["localhost", "127.0.0.1", "0.0.0.0"]
HTTPS_ONLY=False
SECURE_COOKIES=False

# ============================================
# Monitoring Configuration
# ============================================
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=8001
GRAFANA_ENABLED=True
GRAFANA_PORT=3001

# ============================================
# Feature Flags
# ============================================
ENABLE_VOICE=True
ENABLE_VISION=False
ENABLE_AUTOMATION=False
ENABLE_AGENTS=False
ENABLE_PLUGINS=False
